{
  "name": "neoquiz-neonatologie",
  "version": "0.1.0",
  "private": true,
  "description": "Lern-Quiz zur Vorbereitung auf die Schwerpunktprüfung Neonatologie (Landesärztekammer Hessen)",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "lookups": "node scripts/lookups.mjs",
