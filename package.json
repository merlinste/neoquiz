    "test": "node --test tests/*.test.mjs",
    "dev": "npm run build && npx serve public"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@netlify/blobs": "^10.7.13",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@netlify/functions": "^4.1.0"
  }
}
