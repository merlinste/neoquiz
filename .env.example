# Netlify-Umgebungsvariablen (im Netlify-UI unter Site configuration → Environment variables setzen)
ANTHROPIC_API_KEY=sk-ant-...        # Pflicht für KI-Bewertung und Prüfungssimulation
CLAUDE_MODEL=claude-opus-5-5        # optional, Standard: claude-opus-5-5
APP_PASSWORD=                       # PFLICHT: ohne diesen Zugangscode sind /api/evaluate und /api/oral gesperrt.
                                    # Denselben Wert im Quiz unter Einstellungen → Zugangscode eintragen.
AI_RATE_LIMIT=60                    # optional: KI-Bewertungen pro Stunde und Lerner-Code bzw. IP (Standard 60)
ORAL_RATE_LIMIT=90                  # optional: Gesprächszüge der Prüfungssimulation pro Stunde (Standard 90)
ELEVENLABS_API_KEY=                 # optional: Prüferstimme im Prüfungsgespräch über ElevenLabs (sonst Browserstimme)
ELEVENLABS_VOICE_ID=                # optional: Stimme aus der Voice Library, Standard „George“
ELEVENLABS_MODEL=eleven_v4_turbo    # optional
TTS_RATE_LIMIT=120                  # optional: vorgelesene Prüferzüge pro Stunde
